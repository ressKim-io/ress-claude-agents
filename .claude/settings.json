{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl scale *)",
      "Bash(kubectl rollout *)",
      "Bash(kubectl set *)",
      "Bash(kubectl annotate *)",
      "Bash(kubectl label *)",
      "Bash(argocd app sync --force*)",
      "Bash(argocd app sync * --force*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git branch -D *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh release create *)",
      "Bash(argocd app sync *)",
      "Bash(kubectl run *)"
    ]
  }
}
